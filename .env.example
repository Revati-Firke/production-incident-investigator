# OpsPilot environment configuration

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
PUBLIC_URL=http://localhost:8080

# PostgreSQL (requires pgvector for Phase 5 — use pgvector/pgvector:pg16 in Docker)
DATABASE_URL=postgres://opspilot:opspilot@localhost:5432/opspilot?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# HTTP timeouts (optional)
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# AI (Phase 4)
LLM_PROVIDER=mock
LLM_MODEL=mock-rca-v1
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT=60s

# RAG (Phase 5)
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_SCORE=0
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_SEED_ON_START=true
RAG_SEED_DIR=data/knowledge
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embed-v1

# Integrations (Phase 6)
INTEGRATION_TIMEOUT=15s
LOKI_PROVIDER=mock
PROMETHEUS_PROVIDER=mock
GRAFANA_PROVIDER=mock
GITHUB_PROVIDER=mock
# GITHUB_WRITE_ENABLED=false
SLACK_PROVIDER=mock
SLACK_DEFAULT_CHANNEL=#incidents

# Observability (Phase 9)
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# OTEL_SERVICE_NAME=opspilot

# Hardening (Phase 10)
# API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8088
# GRAFANA_WEBHOOK_SECRET=
RATE_LIMIT_PER_MINUTE=120
