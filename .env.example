# OpsPilot environment configuration

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://opspilot:opspilot@localhost:5432/opspilot?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# HTTP timeouts (optional)
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# AI (Phase 4)
# mock = deterministic local RCA (default, no API key required)
# openai = OpenAI-compatible Chat Completions API
LLM_PROVIDER=mock
LLM_MODEL=mock-rca-v1
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT=60s

# Integrations (Phase 6+)
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=
# SLACK_BOT_TOKEN=
# GRAFANA_URL=
# PROMETHEUS_URL=
# LOKI_URL=
