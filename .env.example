# OpsPilot environment configuration

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# PostgreSQL (requires pgvector for Phase 5 — use pgvector/pgvector:pg16 in Docker)
DATABASE_URL=postgres://opspilot:opspilot@localhost:5432/opspilot?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# HTTP timeouts (optional)
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# AI (Phase 4)
# mock = deterministic local RCA (default, no API key required)
# openai = OpenAI-compatible Chat Completions API
LLM_PROVIDER=mock
LLM_MODEL=mock-rca-v1
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT=60s

# RAG (Phase 5)
RAG_ENABLED=true
RAG_TOP_K=5
RAG_MIN_SCORE=0
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_SEED_ON_START=true
RAG_SEED_DIR=data/knowledge
# mock = deterministic local embeddings (default)
# openai = OpenAI-compatible /embeddings (dimensions=384)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embed-v1
# EMBEDDING_API_KEY=   # falls back to LLM_API_KEY
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_TIMEOUT=60s

# Integrations (Phase 6+)
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=
# SLACK_BOT_TOKEN=
# GRAFANA_URL=
# PROMETHEUS_URL=
# LOKI_URL=
