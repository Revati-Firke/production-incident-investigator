# OpsPilot environment configuration

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://opspilot:opspilot@localhost:5432/opspilot?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# HTTP timeouts (optional)
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# AI (Phase 4+)
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o

# Integrations (Phase 6+)
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=
# SLACK_BOT_TOKEN=
